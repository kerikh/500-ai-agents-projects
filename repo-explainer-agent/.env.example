# Copy this file to `.env` and fill in values. `.env` is gitignored — never commit secrets.

# --- Cloud OpenAI (default provider) ---
# OPENAI_API_KEY=sk-your-openai-key
# REPO_EXPLAINER_MODEL=gpt-4o-mini

# --- Local OpenAI-compatible server (Ollama, LM Studio, vLLM, etc.) ---
# Point at the server's /v1 endpoint. Most local servers accept any API key.
REPO_EXPLAINER_BASE_URL=http://localhost:11434/v1
REPO_EXPLAINER_API_KEY=local
REPO_EXPLAINER_MODEL=llama3.2

# Optional: sampling temperature for the Teacher stage (default 0.2)
# REPO_EXPLAINER_TEMPERATURE=0.2
